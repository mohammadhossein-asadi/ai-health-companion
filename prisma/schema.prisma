generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  healthData HealthData?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Health Data (one-to-one with User) ─────────────────────

model HealthData {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON blobs for each module
  sleepJson       String @default("[]")
  exerciseJson    String @default("[]")
  skinJson        String @default("[]")
  hairJson        String @default("[]")
  nutritionJson   String @default("[]")
  supplementsJson String @default("{}")
  waterJson       String @default("[]")
  bloodTestJson   String @default("[]")
  bmiJson         String @default("[]")
  caloriesJson    String @default("[]")

  // Module settings
  sleepGoalHours       Int    @default(8)
  exerciseStepGoal     Int    @default(10000)
  exerciseWorkoutGoal  Int    @default(5)
  waterDailyTargetMl   Int    @default(2500)
  nutritionCalorieTarget Int  @default(2000)
  dailyCalorieTarget   Int    @default(2200)

  // Profile
  profileName    String  @default("")
  profileAge     Int     @default(30)
  profileGender  String  @default("male")
  profileDob     String  @default("")

  // Settings
  language String @default("en")
  theme    String @default("dark")

  // Last AI insight
  lastInsightJson String @default("{}")

  updatedAt DateTime @updatedAt
}
